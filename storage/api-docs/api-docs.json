{
    "openapi": "3.0.0",
    "info": {
        "title": "XBoard API",
        "description": "API for P2P cryptocurrency exchange with escrow guarantee",
        "version": "1.0.0"
    },
    "servers": [
        {
            "url": "http://sandbox.api.xrpchange.site/api/v1",
            "description": "Sandbox server (for testing)"
        },
        {
            "url": "http://api.xrpchange.site/api/v1",
            "description": "Production server"
        },
        {
            "url": "http://localhost:8000/api/v1",
            "description": "Local server"
        }
    ],
    "paths": {
        "/auth/bearer-token": {
            "post": {
                "tags": [
                    "Authentication"
                ],
                "summary": "Get Bearer token",
                "description": "Get Bearer token by escrow token",
                "operationId": "f3d61420ca095c8a98af8aebfb33c5bc",
                "parameters": [
                    {
                        "name": "escrow_token",
                        "in": "query",
                        "description": "Escrow token for authentication",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "maxLength": 500
                        }
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "escrow_token"
                                ],
                                "properties": {
                                    "escrow_token": {
                                        "type": "string",
                                        "maxLength": 500
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Bearer token received",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "success": {
                                            "type": "boolean"
                                        },
                                        "data": {
                                            "properties": {
                                                "bearer_token": {
                                                    "type": "string"
                                                },
                                                "expires_at": {
                                                    "type": "string",
                                                    "format": "date-time"
                                                }
                                            },
                                            "type": "object"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Invalid escrow token"
                    },
                    "422": {
                        "description": "Validation error"
                    }
                }
            }
        },
        "/countries": {
            "get": {
                "tags": [
                    "Countries"
                ],
                "summary": "Get countries list",
                "operationId": "87b1e43e1fee480e4db58b462bf951c0",
                "parameters": [
                    {
                        "name": "search",
                        "in": "query",
                        "description": "Search by country name or code",
                        "required": false,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Countries list",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "success": {
                                            "type": "boolean"
                                        },
                                        "data": {
                                            "type": "array",
                                            "items": {
                                                "$ref": "#/components/schemas/Country"
                                            }
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/currencies/fiat": {
            "get": {
                "tags": [
                    "Currencies"
                ],
                "summary": "Get fiat currencies list",
                "operationId": "030dd308e3775343bf8dc4bbc7f970c3",
                "parameters": [
                    {
                        "name": "search",
                        "in": "query",
                        "description": "Search by currency name or code",
                        "required": false,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Fiat currencies list",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "success": {
                                            "type": "boolean"
                                        },
                                        "data": {
                                            "type": "array",
                                            "items": {
                                                "$ref": "#/components/schemas/FiatCurrency"
                                            }
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    }
                }
            }
        }
    },
