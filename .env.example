# Copy to .env and fill in values.

# --- Core API (xboard-core). Required for API-only endpoints: token creation, delete reservation. Must match Core [api] CORE_API_KEY. ---
# CORE_URL=https://sandbox.api.core.xdexboard.com
# CORE_KEY=                            # Same value as Core config [api] CORE_API_KEY (generate: php -r "echo bin2hex(random_bytes(32));")
# CORE_TIMEOUT=10
# CORE_CREATE_TIMEOUT=120           # API → Core for POST /escrow-tokens/create (Stellar friendbot/trustline can exceed 10s)
# CORE_PAYOUT_TIMEOUT=120              # Longer timeout for on-chain payout / AML routes

# --- Deal AML provider failure alert (operator inbox) ---
# When Core returns AML_PROVIDER_UNAVAILABLE during deal crypto payout, API sends a plain-text
# critical alert with the full Core JSON body. No AML screening charge is applied to the participant.
# If empty: Core [admin] admin_email via POST /api/internal/notification-admin-email (same mailbox as
# fee-wallet verification codes), then ARBITER_OPERATOR_ESCALATION_EMAIL. See docs/AML_DEAL_PERSISTENCE.md.
# AML_ADMIN_ALERT_EMAIL=
# CORE_PRODUCTION_URL=https://api.core.xdexboard.com
# CORE_PRODUCTION_KEY=                 # Same value as Core config [api] CORE_API_KEY for production
# CORE_PRODUCTION_TIMEOUT=10
# CORE_PRODUCTION_CREATE_TIMEOUT=120
# CORE_PRODUCTION_PAYOUT_TIMEOUT=120   # Longer timeout for production payout routes

# --- AI Arbiter (server-side only, do not expose to clients) ---
# Single LLM provider per deployment: only ARBITER_PRIMARY_PROVIDER is invoked (no failover to other vendors).
# Client provider hints are optional and not used for routing.
# GigaChat (Sber): authorization key from https://developers.sber.ru/studio — used for OAuth, then chat/completions.
# ARBITER_PRIMARY_PROVIDER=gigachat
# ARBITER_FALLBACK_PROVIDERS is deprecated and ignored — do not use.
# ARBITER_GIGACHAT_AUTHORIZATION_KEY=
# ARBITER_GIGACHAT_SCOPE=GIGACHAT_API_PERS
# ARBITER_GIGACHAT_OAUTH_URL=https://ngw.devices.sberbank.ru:9443/api/v2/oauth
# ARBITER_GIGACHAT_API_BASE_URL=https://gigachat.devices.sberbank.ru/api/v1
# ARBITER_GIGACHAT_MODEL=GigaChat
# ARBITER_GIGACHAT_TIMEOUT=45
# TLS verify for Sber OAuth + GigaChat API. Unset = verify only when APP_ENV=production; set explicitly on prod if needed.
# ARBITER_GIGACHAT_VERIFY_SSL=true
# To use a different vendor as the sole provider, set ARBITER_PRIMARY_PROVIDER to that id (e.g. deepseek) and configure its keys — still no failover chain.
# ARBITER_NO_AI_BELOW=0.35
# ARBITER_MANUAL_REVIEW_THRESHOLD=0.55
# ARBITER_RESOLVE_ON_FAVOR_BUYER=true
# ARBITER_RESOLVE_ON_FAVOR_SELLER=true
# ARBITER_FORCE_CLOSE_BUYER_DISPUTE_ON_FAVOR_SELLER=true
# ARBITER_AUTO_CORE_PAYOUT_ON_FAVOR_BUYER=false   # true: Core reads seller token from reservations/test_reservations and runs deal payout (X-Core-Key)
# When LLM returns verdict favor_buyer|favor_seller (JSON line) and arbiter_status is in_review, close active deal_disputes (unblocks crypto payout). Signing still uses seller escrow token on client.
# ARBITER_DEEPSEEK_API_KEY=
# ARBITER_DEEPSEEK_BASE_URL=https://api.deepseek.com
# ARBITER_DEEPSEEK_MODEL=deepseek-chat
# ARBITER_DEEPSEEK_TIMEOUT=30
# ARBITER_ANTHROPIC_API_KEY=
# ARBITER_ANTHROPIC_MODEL=claude-3-7-sonnet-latest
# ARBITER_ANTHROPIC_TIMEOUT=20
# ARBITER_OPENAI_API_KEY=
# ARBITER_OPENAI_MODEL=gpt-4o-mini
# ARBITER_OPENAI_TIMEOUT=20
# Max receipt PDF size (bytes) read from disk and sent as a separate file to Anthropic / OpenAI Responses when pdf_sha256 matches storage.
# ARBITER_RECEIPT_PDF_MAX_BYTES=5242880
# Max UTF-8 characters of PDF plain text (smalot/pdfparser) put in the text prompt for all providers (incl. GigaChat / DeepSeek).
# ARBITER_RECEIPT_PDF_TEXT_EXCERPT_MAX_CHARS=8000
# When receipt PDF matches on disk but has no extractable text (image-only), email full deal context to the operator inbox. Leave empty to log only.
# Template (English copy + buttons): resources/views/mail/arbiter_operator_escalation.blade.php — config/arbiter_operator_mail.php
ARBITER_OPERATOR_ESCALATION_EMAIL=tehnograny@yandex.ru
ARBITER_OPERATOR_ACTION_LINK_TTL_DAYS=7

# --- Technical sender (noreply) — for sending codes and system emails. See docs/NOREPLY_MAILBOX_SETUP.md ---
# Set APP_URL to your API base URL so SMTP EHLO (mail.local_domain) is not "localhost".
# APP_URL=https://sandbox.api.xdexboard.com
# MAIL_MAILER=smtp
# MAIL_HOST=mail.xdexboard.com
# MAIL_PORT=587
# MAIL_USERNAME=noreply@xdexboard.com
# MAIL_PASSWORD=
# MAIL_ENCRYPTION=tls
# MAIL_EHLO_DOMAIN=sandbox.api.xdexboard.com
# MAIL_FROM_ADDRESS=noreply@xdexboard.com
# MAIL_FROM_NAME="XBoard"

# --- Deal external notification daily limit (anti-abuse, per recipient email) ---
# One shared counter (DB: email_test_counters) for all of the below, per calendar day in the app timezone.
# EN: Counts each send to seller_notification_email / buyer_notification_email on start_deal, plus test/emergency
#     POST .../send-test-notification-email (with lot and standalone). When the limit is reached, extra external
#     mails are skipped (logged); internal lot mailbox mail is unaffected.
# RU: Дневной лимит на один адрес: внешние письма при входе покупателя в сделку + тестовые/аварийные уведомления.
# Config key: mail.test_email_daily_limit (config/mail.php). Omit this line to use the default (30).
MAIL_TEST_EMAIL_DAILY_LIMIT=30

# --- Deal emails (start_deal → seller_notification_email): HTTPS/open-deal link uses the same host as the API request; xboard:// base is fixed in code. See docs/DEAL_EMAIL_SUBJECT_TAG.md ---

# --- Deal chat limits (per-lot history and message size). Safe defaults used if unset. ---
# Maximum number of chat messages stored per deal (per exchange_lot_id). Older messages are pruned.
# DEAL_CHAT_MAX_MESSAGES=1000
# Maximum length of a single chat message body (characters). Longer messages are truncated on server and blocked on client.
# DEAL_CHAT_MAX_MESSAGE_LENGTH=1000

# --- AI arbiter invocation cap (per exchange lot). Atomic reservation before LLM; see docs/AI_ARBITER_SERVER.md § Per-lot AI invocation budget ---
# Primary: max POST /arbiter-message reservations per lot (default 30). Set to 0 to disable (not recommended in production).
# DEAL_MAX_AI_ARBITER_INVOCATIONS_PER_LOT=30
# While dispute is open, block buyer cancel + seller exit for this many hours (default 24) to allow compensation decision.
# DEAL_ACTIVE_DISPUTE_EXIT_LOCK_HOURS=24
# Receipt payment time may be older than deal start by up to this many hours (UTC) when opening dispute (default 12).
# DEAL_BANK_RECEIPT_DISPUTE_TIME_GRACE_HOURS=12
# Legacy alias used only if DEAL_MAX_AI_ARBITER_INVOCATIONS_PER_LOT is unset:
# DEAL_MAX_AI_ARBITER_MESSAGES_PER_LOT=30

# --- Sandbox virtual receipt bank (optional). Not stored in `banks`; only merged into bank lists on sandbox.* / dev.* API hosts. See docs/SANDBOX_VIRTUAL_BANK.md ---
# Public website hostname for the synthetic bank (shown in PDF/API metadata; do not include https://).
# SANDBOX_VIRTUAL_BANK_WEBSITE=sandbox-receipt.xdexboard.com
# Must match `countries.code` for the receipt-bank country. Same default (RUS) in config if this line is omitted.
SANDBOX_VIRTUAL_BANK_COUNTRY_CODE=RUS
# Integer id returned in JSON for this bank (create/update lots with bank_id = this value on sandbox + is_test). Default 900000001 if unset.
# SANDBOX_VIRTUAL_BANK_ID=900000001
# Optional: comma-separated HTTP Host values (e.g. 192.168.1.10) where virtual bank is merged if Host is not sandbox.* / dev.* — docs/SANDBOX_VIRTUAL_BANK.md
# SANDBOX_VIRTUAL_BANK_EXTRA_PREPEND_HOSTS=

# --- Web Push (browser deal chat when tab in background). Generate: php artisan web-push:generate-vapid ---
# WEB_PUSH_ENABLED=true
# WEB_PUSH_VAPID_PUBLIC_KEY=
# WEB_PUSH_VAPID_PRIVATE_KEY=
# WEB_PUSH_VAPID_SUBJECT=mailto:admin@xdexboard.com
