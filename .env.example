# Copy to .env and fill in values.

# --- Core API (xboard-core). Required for API-only endpoints: token creation, delete reservation. Must match Core [api] CORE_API_KEY. ---
# CORE_URL=https://sandbox.api.core.xdexboard.com
# CORE_KEY=                            # Same value as Core config [api] CORE_API_KEY (generate: php -r "echo bin2hex(random_bytes(32));")
# CORE_TIMEOUT=10
# CORE_PRODUCTION_URL=https://api.core.xdexboard.com
# CORE_PRODUCTION_KEY=                 # Same value as Core config [api] CORE_API_KEY for production
# CORE_PRODUCTION_TIMEOUT=10

# --- AI Arbiter (server-side only, do not expose to clients) ---
# Primary provider is selected by server policy. Client provider hints are optional and not authoritative.
# Default primary in config is gigachat; default fallback is deepseek (set keys below).
# GigaChat (Sber): authorization key from https://developers.sber.ru/studio — used for OAuth, then chat/completions.
# ARBITER_PRIMARY_PROVIDER=gigachat
# ARBITER_FALLBACK_PROVIDERS=deepseek,anthropic,openai
# ARBITER_GIGACHAT_AUTHORIZATION_KEY=
# ARBITER_GIGACHAT_SCOPE=GIGACHAT_API_PERS
# ARBITER_GIGACHAT_OAUTH_URL=https://ngw.devices.sberbank.ru:9443/api/v2/oauth
# ARBITER_GIGACHAT_API_BASE_URL=https://gigachat.devices.sberbank.ru/api/v1
# ARBITER_GIGACHAT_MODEL=GigaChat
# ARBITER_GIGACHAT_TIMEOUT=45
# ARBITER_GIGACHAT_VERIFY_SSL=true
# EU/US-friendly example (no GigaChat):
# ARBITER_PRIMARY_PROVIDER=anthropic
# ARBITER_FALLBACK_PROVIDERS=openai,deepseek
# ARBITER_NO_AI_BELOW=0.35
# ARBITER_MANUAL_REVIEW_THRESHOLD=0.55
# ARBITER_DEEPSEEK_API_KEY=
# ARBITER_DEEPSEEK_BASE_URL=https://api.deepseek.com
# ARBITER_DEEPSEEK_MODEL=deepseek-chat
# ARBITER_DEEPSEEK_TIMEOUT=30
# ARBITER_ANTHROPIC_API_KEY=
# ARBITER_ANTHROPIC_MODEL=claude-3-7-sonnet-latest
# ARBITER_ANTHROPIC_TIMEOUT=20
# ARBITER_OPENAI_API_KEY=
# ARBITER_OPENAI_MODEL=gpt-4o-mini
# ARBITER_OPENAI_TIMEOUT=20

# --- Technical sender (noreply) — for sending codes and system emails. See docs/NOREPLY_MAILBOX_SETUP.md ---
# MAIL_MAILER=smtp
# MAIL_HOST=mail.xdexboard.com
# MAIL_PORT=587
# MAIL_USERNAME=noreply@xdexboard.com
# MAIL_PASSWORD=
# MAIL_ENCRYPTION=tls
# MAIL_FROM_ADDRESS=noreply@xdexboard.com
# MAIL_FROM_NAME="XBoard"

# --- Deal emails (start_deal → seller_notification_email): HTTPS/open-deal link uses the same host as the API request; xboard:// base is fixed in code. See docs/DEAL_EMAIL_SUBJECT_TAG.md ---
