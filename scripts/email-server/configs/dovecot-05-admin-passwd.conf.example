# admin@xdexboard.com — operator / representation mailbox (not lot_mailboxes, not send_only).
# Incoming: Postfix virtual alias (operator-forward.map) → external inbox.
# Outbound SMTP (587/465): Dovecot SASL + sender_login_maps (MAIL FROM must match login).
# Copy to /etc/dovecot/conf.d/05-admin-passwd.conf
# Password file: /etc/dovecot/passwd.admin (root:dovecot 0640), one line:
#   admin@xdexboard.com:{SHA512-CRYPT}$6$...
passdb {
  driver = passwd-file
  args = username_format=%u /etc/dovecot/passwd.admin
}
userdb {
  driver = static
  args = uid=vmail gid=vmail home=/var/mail/vhosts/xdexboard.com/admin mail=maildir:~/
}
