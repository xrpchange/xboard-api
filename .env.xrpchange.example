# Copy to .env.xrpchange (gitignored) — local second-exchange simulation only.
# Apache: SetEnv APP_ENV xrpchange on api.xrpchange.site vhosts.

APP_ENV=xrpchange
APP_NAME="XBoard API (XRPChange local)"
APP_URL=https://api.xrpchange.site

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=xboard2
DB_USERNAME=
DB_PASSWORD=

# Core URLs for xrpchange.* vhosts on this machine (adjust to your local Core vhosts)
CORE_URL=https://sandbox.api.core.xrpchange.site
CORE_KEY=
CORE_PRODUCTION_URL=https://api.core.xrpchange.site
CORE_PRODUCTION_KEY=
